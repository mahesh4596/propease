<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1080.0" stylesheets="@Customerv.css" styleClass="root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Customer.CustomerController">
    <children>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="800.0" prefWidth="1080.0" styleClass="page-scroll" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox prefWidth="1080.0" spacing="18.0">
                    <padding>
                        <Insets bottom="28.0" left="24.0" right="24.0" top="24.0" />
                    </padding>
                    <children>

                        <VBox alignment="CENTER" spacing="4.0">
                            <children>
                                <Label fx:id="title" text="👥 Customer Master">
                                    <font>
                                        <Font size="40.0" />
                                    </font>
                                </Label>
                                <Label styleClass="subtitle-label" text="Add, search, and manage customer records" />
                            </children>
                        </VBox>

                        <VBox prefWidth="960.0" spacing="24.0" styleClass="form-card">
                            <padding>
                                <Insets bottom="32.0" left="46.0" right="46.0" top="32.0" />
                            </padding>
                            <children>

                                <GridPane hgap="40.0" vgap="18.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                    </columnConstraints>
                                    <children>
                                        <VBox spacing="6.0" styleClass="field-group" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <children>
                                                <Label styleClass="field-label" text="📱 Mobile" />
                                                <HBox spacing="10.0">
                                                    <children>
                                                        <TextField fx:id="txtMob" prefHeight="34.0" prefWidth="220.0" promptText="10-digit mobile number" />
                                                        <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#doSearch" prefHeight="34.0" prefWidth="100.0" text="🔎 Search">
                                                            <font>
                                                                <Font size="15.0" />
                                                            </font>
                                                        </Button>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <VBox spacing="6.0" styleClass="field-group" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <children>
                                                <Label styleClass="field-label" text="👤 Name" />
                                                <TextField fx:id="txtName" prefHeight="34.0" prefWidth="380.0" promptText="Full name" />
                                            </children>
                                        </VBox>
                                    </children>
                                </GridPane>

                                <GridPane hgap="40.0" vgap="18.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                    </columnConstraints>
                                    <children>
                                        <VBox spacing="6.0" styleClass="field-group" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <children>
                                                <Label styleClass="field-label" text="🏙 City" />
                                                <TextField fx:id="txtCity" prefHeight="34.0" prefWidth="220.0" promptText="City" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="6.0" styleClass="field-group" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <children>
                                                <Label styleClass="field-label" text="🏠 Address" />
                                                <TextField fx:id="txtAddr" prefHeight="42.0" prefWidth="380.0" promptText="Street, area, landmark" />
                                            </children>
                                        </VBox>
                                    </children>
                                </GridPane>

                                <GridPane hgap="40.0" vgap="18.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                    </columnConstraints>
                                    <children>
                                        <VBox spacing="6.0" styleClass="field-group" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <children>
                                                <Label styleClass="field-label" text="🏷 Customer Type" />
                                                <ComboBox fx:id="comboType" prefHeight="34.0" prefWidth="220.0" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="6.0" styleClass="field-group" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <children>
                                                <Label styleClass="field-label" text="✉ Email id" />
                                                <TextField fx:id="txtMail" prefHeight="34.0" prefWidth="380.0" promptText="name@example.com" />
                                            </children>
                                        </VBox>
                                    </children>
                                </GridPane>

                                <Label styleClass="section-label" text="📁 Documents" />

                                <GridPane hgap="40.0" vgap="18.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                    </columnConstraints>
                                    <children>
                                        <VBox spacing="10.0" styleClass="field-group" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <children>
                                                <Label styleClass="field-label" text="🖼 Customer Pic" />
                                                <HBox alignment="CENTER_LEFT" spacing="18.0">
                                                    <children>
                                                        <StackPane styleClass="photo-frame">
                                                            <children>
                                                                <ImageView fx:id="Prev1" fitHeight="140.0" fitWidth="190.0" pickOnBounds="true" preserveRatio="true" />
                                                            </children>
                                                        </StackPane>
                                                        <Button fx:id="btnBrowsePic" mnemonicParsing="false" onAction="#doBrowseCustomerPic" prefHeight="34.0" prefWidth="110.0" text="📂 Browse">
                                                            <font>
                                                                <Font size="15.0" />
                                                            </font>
                                                        </Button>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <VBox spacing="10.0" styleClass="field-group" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <children>
                                                <Label styleClass="field-label" text="🪪 Aadhaar Card" />
                                                <HBox alignment="CENTER_LEFT" spacing="18.0">
                                                    <children>
                                                        <StackPane styleClass="photo-frame">
                                                            <children>
                                                                <ImageView fx:id="Prev2" fitHeight="140.0" fitWidth="190.0" pickOnBounds="true" preserveRatio="true" />
                                                            </children>
                                                        </StackPane>
                                                        <Button fx:id="btnBrowseAdhaar" mnemonicParsing="false" onAction="#doBrowseAdhaarCard" prefHeight="34.0" prefWidth="110.0" text="📂 Browse">
                                                            <font>
                                                                <Font size="15.0" />
                                                            </font>
                                                        </Button>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </GridPane>

                            </children>
                        </VBox>

                        <HBox alignment="CENTER" spacing="20.0" styleClass="action-bar">
                            <children>
                                <Button fx:id="btnSave" mnemonicParsing="false" onAction="#doSave" prefHeight="38.0" prefWidth="120.0" text="💾 Save">
                                    <font>
                                        <Font size="17.0" />
                                    </font>
                                </Button>
                                <Button fx:id="btnUpdate" mnemonicParsing="false" onAction="#doUpdate" prefHeight="38.0" prefWidth="120.0" text="♻ Update">
                                    <font>
                                        <Font size="17.0" />
                                    </font>
                                </Button>
                                <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#doDelete" prefHeight="38.0" prefWidth="120.0" text="🗑 Delete">
                                    <font>
                                        <Font size="17.0" />
                                    </font>
                                </Button>
                                <Button fx:id="btnClear" mnemonicParsing="false" onAction="#doClear" prefHeight="38.0" prefWidth="120.0" text="🧹 Clear">
                                    <font>
                                        <Font size="17.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
